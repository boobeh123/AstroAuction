<%- include('./partials/head.ejs') %>
<%- include('./partials/navigation.ejs') %>
<%- include('./partials/flash.ejs') %>
<main id="main-content">
    <section class="hero">
        <canvas id="hero-particles" class="hero-particles" aria-hidden="true"></canvas>
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Streamline your <strong>garage sale experience</strong> with AstroAuctions</h1>
                <a href="/auction" class="btn btn-secondary">View Auction</a>
                <a href="https://www.instagram.com/35Mangostreet" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Visit Our Instagram</a>
            </div>
        </div>
        <div class="hero-image">
            <div class="hero-image-frame">
                <img src="/images/astrologo.webp" alt="Astro Auction - Cosmic Auction House" width="600" height="600">
                <div class="hero-corner hero-corner--tl" aria-hidden="true"></div>
                <div class="hero-corner hero-corner--tr" aria-hidden="true"></div>
                <div class="hero-corner hero-corner--bl" aria-hidden="true"></div>
                <div class="hero-corner hero-corner--br" aria-hidden="true"></div>
                <div class="hero-scan" aria-hidden="true"></div>
                <div class="orbit-ring" aria-hidden="true">
                    <div class="orbit-particle">&#10022;</div>
                    <div class="orbit-particle">&#10022;</div>
                    <div class="orbit-particle">&#10022;</div>
                    <div class="orbit-particle">&#10022;</div>
                </div>
            </div>
        </div>
    </section>
</main>
<%- include('./partials/footer.ejs') %>