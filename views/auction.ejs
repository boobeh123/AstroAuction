<%- include('./partials/head.ejs') %>
<%- include('./partials/navigation.ejs') %>
<%- include('./partials/flash.ejs') %>
<main id="main-content" class="auction-page">
      <header class="auction-hero"> 
        <h1 class="auction-title">Auction Listings</h1>
        <p class="auction-subtitle">Browse the latest items. Create an account, verify your email & create a listing.</p>
      </header>
      <div class="auction-layout auction-layout--single">
        <div class="auction-main">
          <section class="auction-card auction-card-list" aria-labelledby="latestListingsTitle">
            <header class="auction-list-header">
              <h2 class="auction-card-title" id="latestListingsTitle">Latest Listings</h2>
              <p class="auction-list-meta" aria-live="polite" aria-atomic="true">
                <%= (listings && listings.length) ? listings.length : 0 %> total
                <%= (listings && listings.length === 1) ? 'listing' : 'listings' %>
              </p>
            </header>

            <% if (listings && listings.length > 0) { %>
              <div class="auction-listings">
                <% listings.forEach(listing => { %>
                  <article class="listing-card" id="listing-<%= listing.id %>">
                    <div class="listing-card-media">
                      <span class="listing-category-badge"><%= listing.category %></span>
                      <% if (listing.images && listing.images.length > 0) { %>
                        <img class="listing-card-image" src="<%= listing.images[0] %>" alt="<%= listing.title %>" loading="lazy" width="400" height="300">
                      <% } %>
                    </div>
                      <div class="listing-card-body">
                        <h3 class="listing-card-title"><%= listing.title %></h3>
                        <% if (listing.user) { %>
                          <div class="listing-card-seller">
                            <img src="<%= listing.user.image || 'https://placeholder.pics/svg/100x100' %>" alt="<%= listing.user.image ? listing.user.displayName : 'No' %> profile photo" loading="lazy" class="seller-avatar" width="32" height="32">
                            <span class="seller-name">Posted by: <%= listing.user.displayName %></span>
                          </div>
                          <% } %>
                          <div class="listing-card-actions">
                            <a href="/auction/viewAuction/<%= listing._id %>" class="btn btn-secondary">View Details</a>
                            <% if (user && listing.user && listing.user._id.toString() === user.id) { %>
                              <form action="/auction/deleteAuction/<%= listing._id %>?_method=DELETE" method="POST" class="deleteForm"> 
                                <button type="submit" class="btn red waves-effect waves-light hoverable">Delete</button>
                              </form>
                              <% } %>
                            </div>
                          </div>
                          </article>
              <% }) %>
              </div>
          <% } else { %>
            <div class="auction-empty">
              <h3 class="auction-empty-title">No listings yet</h3>
              <p class="auction-empty-text">Create your first listing using the Create Listing button above.</p>
            </div>
          <% } %>
        </section>
      </div>
  </div>
</main>

<% if (typeof user !== 'undefined' && user && user.onboardingComplete) { %>
<div class="modal-overlay" id="create-listing-modal" role="dialog" aria-modal="true" aria-labelledby="create-listing-modal-title" hidden>
  <div class="modal-panel">
    <div class="modal-header">
      <h2 class="modal-title" id="create-listing-modal-title">Create Listing</h2>
      <button type="button" class="modal-close" id="create-listing-modal-close" aria-label="Close">&times;</button>
    </div>
    <form action="/auction" method="POST" enctype="multipart/form-data" id="create-listing-form">
      <div class="form-group">
        <label for="modal-title-input">Title <span class="required">*</span></label>
        <input id="modal-title-input" type="text" name="title" placeholder="Enter item title" maxlength="100" required aria-required="true" autocomplete="off">
        <span class="char-counter" id="title-counter">0 / 100</span>
      </div>
      <div class="form-group">
        <label for="modal-desc-input">Description <span class="required">*</span></label>
        <textarea id="modal-desc-input" name="description" placeholder="Enter item description" rows="3" maxlength="2000" required aria-required="true"></textarea>
        <span class="char-counter" id="desc-counter">0 / 2000</span>
      </div>
      <div class="form-group">
        <label for="modal-category-input">Category <span class="required">*</span></label>
        <select id="modal-category-input" name="category" required aria-required="true">
          <option value="" selected>Select a category</option>
          <option value="Art">Art</option>
          <option value="Antiques">Antiques</option>
          <option value="Coins & Collectibles">Coins & Collectibles</option>
          <option value="Jewelry & Watches">Jewelry & Watches</option>
          <option value="Fashion">Fashion</option>
          <option value="Home Decor & Goods">Home Decor & Goods</option>
          <option value="Lawn & Garden">Lawn & Garden</option>
          <option value="Furniture">Furniture</option>
          <option value="Sports Goods">Sports Goods</option>
          <option value="Toys">Toys</option>
          <option value="Electronics">Electronics</option>
          <option value="Cars">Cars</option>
          <option value="Construction">Construction</option>
          <option value="Services">Services</option>
        </select>
      </div>
      <div class="form-group">
        <label id="video-toggle-label">Does this listing include a video?</label>
        <div class="toggle-group" role="group" aria-labelledby="video-toggle-label">
          <div class="toggle-option">
            <input type="radio" name="has-video" id="video-no" value="no" checked>
            <label for="video-no">No</label>
          </div>
          <div class="toggle-option">
            <input type="radio" name="has-video" id="video-yes" value="yes">
            <label for="video-yes">Yes</label>
          </div>
        </div>
        <div class="video-url-field" id="video-url-field">
          <input type="url" id="video-url-input" name="video" placeholder="https://youtube.com/watch?v=...">
          <small>Paste a YouTube link — direct video upload from your phone isn't supported yet.</small>
        </div>
      </div>
      <div class="form-group">
        <label>Photos (optional, up to 10)</label>
        <div class="dropzone" id="dropzone">
          <input id="modal-file-input" type="file" name="file" accept="image/*" multiple>
          <span class="dropzone-prompt" id="dropzone-prompt"><i class="fas fa-image" aria-hidden="true"></i>Drag photos here, or click to browse</span>
        </div>
        <div class="gallery-grid" id="gallery-grid"></div>
        <span class="gallery-count" id="gallery-count">0 / 10 photos</span>
      </div>
      <div class="auction-form-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> Create</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include('./partials/footer.ejs') %>