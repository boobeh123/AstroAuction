<%- include('./partials/head.ejs') %>
<%- include('./partials/navigation.ejs') %>
<%- include('./partials/flash.ejs') %>

<main id="main-content" class="detailed-auction-page">
    <div class="container">
        <div class="detailed-nav">
          <a href="/auction" class="btn-back" aria-label="Back to listings"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Listings</a>
        </div>
        <div class="detailed-auction-layout">
          <div class="detailed-auction-main">
            <% if (videoEmbedUrl) { %>
              <div class="detailed-video-container">
                <iframe src="<%= videoEmbedUrl %>" title="<%= listing.title %> video" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
              </div>
              <% if (listing.images && listing.images.length > 0) { %>
                <div class="detailed-image-strip" aria-label="Listing photos">
                  <% listing.images.forEach((img, index) => { %>
                    <button type="button" class="detailed-strip-thumb" data-image-url="<%= img %>" aria-label="View photo <%= index + 1 %> larger">
                      <img src="<%= img %>" alt="<%= listing.title %>" class="detailed-strip-image" loading="lazy">
                    </button>
                  <% }) %>
                </div>
              <% } %>
            <% } else if (listing.images && listing.images.length > 0) { %>
              <div class="detailed-image-container">
                <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" class="detailed-image" id="detailed-main-image">
              </div>
              <% if (listing.images.length > 1) { %>
                <div class="detailed-image-thumbnails" aria-label="Listing photos">
                  <% listing.images.forEach((img, index) => { %>
                    <button type="button" class="detailed-image-thumb" data-image-url="<%= img %>" aria-label="View photo <%= index + 1 %> of <%= listing.images.length %>" <%= index === 0 ? 'aria-current="true"' : '' %>>
                      <img src="<%= img %>" alt="">
                    </button>
                  <% }) %>
                </div>
              <% } %>
            <% } else { %>
              <div class="detailed-image-container detailed-image-placeholder">
                <i class="fas fa-image" aria-hidden="true"></i>
                <p>No image available</p>
              </div>
            <% } %>
            <div class="detailed-card">
              <div class="detailed-category-badge">
                <i class="fas fa-tag" aria-hidden="true"></i>
                <%= listing.category %>
              </div>
              <h1 class="detailed-title"><%= listing.title %></h1>    
              <div class="detailed-description-section">
                <h2 class="section-title">Description</h2>
                <p class="detailed-description"><%= listing.description %></p>
              </div>
            </div>

            <div class="detailed-card comments-section" aria-labelledby="comments-heading">
              <h2 class="section-title" id="comments-heading">Comments (<%= comments.length %>)</h2>

              <% if (typeof user !== 'undefined' && user) { %>
                <form action="/auction/viewAuction/<%= listing._id %>/comments" method="POST" class="comment-form">
                  <label for="comment-body" class="sr-only">Add a comment</label>
                  <textarea id="comment-body" name="body" rows="3" placeholder="Ask a question or leave a comment..." maxlength="1000" required></textarea>
                  <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
              <% } else { %>
                <p class="comments-signin-prompt"><a href="/login">Log in</a> to leave a comment.</p>
              <% } %>

              <% if (comments && comments.length > 0) { %>
                <ul class="comments-list">
                  <% comments.forEach((comment) => { %>
                    <li class="comment-item">
                      <img src="<%= comment.user.image || 'https://placeholder.pics/svg/100x100' %>" alt="" class="comment-avatar">
                      <div class="comment-body-wrap">
                        <div class="comment-meta">
                          <span class="comment-author"><%= comment.user.displayName %></span>
                          <span class="comment-date"><%= new Date(comment.createdAt).toLocaleDateString() %></span>
                        </div>
                        <p class="comment-text"><%= comment.body %></p>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="comments-empty">No comments yet. Be the first to ask a question!</p>
              <% } %>
            </div>
          </div>
          <aside class="detailed-auction-sidebar">
            <div class="detailed-card">
              <h2 class="section-title">Listing Information</h2>
              <div class="info-list">
                <div class="info-item">
                  <span class="info-label">Listing ID:</span>
                  <span class="info-value"><%= listing._id.toString().slice(-8).toUpperCase() %></span>
                </div>
                <div class="info-item">
                  <span class="info-label">Category:</span>
                  <span class="info-value"><%= listing.category %></span>
                </div>
                <div class="info-item">
                  <span class="info-label">Posted:</span>
                  <span class="info-value"><%= new Date(listing.createdAt).toLocaleDateString() %></span>
                </div>
              </div>
            </div>
            <% if (listing.user) { %>
              <div class="detailed-card seller-card">
                <h2 class="section-title">Seller</h2>
                <div class="seller-info">
                  <img src="<%= listing.user.image || 'https://placeholder.pics/svg/100x100' %>" alt="<%= listing.user.displayName %>" class="seller-avatar-large">
                  <div class="seller-details">
                    <h3 class="seller-name"><%= listing.user.displayName %></h3>
                    <p class="seller-joined">Member since <%= new Date(listing.user.createdAt).toLocaleDateString('en-US', { 
                      month: 'short', 
                      year: 'numeric' 
                    }) %></p>
                  </div>
                </div>
              </div>
            <% } %>
          </aside>
        </div>
      </div>
</main>

<% if (listing.images && listing.images.length > 0) { %>
<div class="image-lightbox-overlay" id="image-lightbox" role="dialog" aria-modal="true" aria-label="Photo preview" hidden>
  <button type="button" class="image-lightbox-close" id="image-lightbox-close" aria-label="Close">&times;</button>
  <img src="" alt="" class="image-lightbox-img" id="image-lightbox-img">
</div>
<% } %>

<%- include('./partials/footer.ejs') %>