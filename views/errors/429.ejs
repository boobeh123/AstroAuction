<%- include('.././partials/head.ejs') %>
<%- include('.././partials/navigation.ejs') %>
<main id="main-content" class="error-page">
    <div class="container">
        <div class="error-content">
            <div class="error-icon">
                <i class="fas fa-hourglass-half" aria-hidden="true"></i>
            </div>
            <h1 class="error-title">429 - Too Many Attempts</h1>
            <p class="error-message">You've tried this too many times in a short while.</p>
            <p class="error-submessage">Please wait 15 minutes, then try again.</p>
            <div class="error-actions">
                <a href="/" class="btn btn-primary"><i class="fas fa-home" aria-hidden="true"></i> Go Home</a>
            </div>
        </div>
    </div>
</main>
<%- include('.././partials/footer.ejs') %>
