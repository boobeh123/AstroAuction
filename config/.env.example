# Copy this file to config/.env and fill in the values.
# config/.env is gitignored, so it's never committed. On Railway, set these
# in the service's Variables tab instead.

# MongoDB connection string
DB_STRING=

# A long random string that signs login cookies. To make one:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port to listen on. Leave empty locally to use 3000; Railway sets its own.
PORT=

# Set to production on Railway. Leave empty locally: npm run dev sets
# development for you.
NODE_ENV=

# The site's public address, used for links in emails, with no trailing
# slash. Locally: http://localhost:3000
APP_URL=

# Cloudinary account for listing and profile photos
CLOUD_NAME=
API_KEY=
API_SECRET=

# Gmail address that sends the site's emails, and its app password
EMAIL_NAME=
EMAIL_PASSWORD=
